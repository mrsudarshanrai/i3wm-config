configuration {
    modes:          "window";
    font:           "Fira Code Retina 11";
    show-icons:     true;

    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

* {
    bg:         #282D3F;
    bg-alt:     #323950;
    accent:     #8651c9;
    accent-alt: #A374DB;
    accent-dim: rgba(134, 81, 201, 12%);
    fg:         #FFFFFF;
    fg-muted:   #9296A8;

    background: @bg;
    lightbg:    @bg-alt;
    foreground: @fg;
    red:        @accent;
    blue:       @accent;

    background-color:   transparent;
    text-color:         @fg;
}

window {
    location:       center;
    width:          640px;
    background-color: @bg;
    border:         2px;
    border-color:   @accent;
    border-radius:  16px;
    padding:        14px;
}

mainbox {
    children:  [ inputbar, listview ];
    spacing:   10px;
    background-color: transparent;
}

inputbar {
    children:       [ prompt, entry ];
    background-color: @bg-alt;
    border-radius:  10px;
    padding:        10px 14px;
    spacing:        10px;
}

prompt {
    text-color:     @accent-alt;
    background-color: transparent;
}

entry {
    placeholder:        "Search…";
    placeholder-color:  @fg-muted;
    text-color:         @fg;
    background-color:   transparent;
    cursor:             pointer;
}

listview {
    background-color: transparent;
    spacing:    4px;
    lines:      10;
    columns:    2;
    padding:    8px 0px 0px 0px;
    scrollbar:  true;
    fixed-height: true;
}

scrollbar {
    width:          4px;
    border-radius:  4px;
    handle-color:   @accent;
    background-color: @bg-alt;
}

element {
    children:      [ element-icon, element-text ];
    background-color: transparent;
    border:        0px 0px 0px 3px;
    border-color:  transparent;
    border-radius: 4px;
    padding:       6px 8px;
    spacing:       10px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:        @fg;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:        @accent-alt;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:        @accent-alt;
}

element selected.normal {
    background-color: @accent-dim;
    border-color:      @accent;
    text-color:         @fg;
}

element selected.active,
element selected.urgent {
    background-color: @accent-dim;
    border-color:      @accent;
    text-color:         @fg;
}

element-icon {
    size:           20px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:     inherit;
    vertical-align: 0.5;
}
